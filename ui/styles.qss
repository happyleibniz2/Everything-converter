QMainWindow {
    background: #f7f8fb;
}

QListWidget,
QLineEdit {
    background: #ffffff;
    border: 1px solid #d6dbe6;
    border-radius: 6px;
    padding: 8px;
}

QFrame#dropArea {
    background: #ffffff;
    border: 2px dashed #9aa7bd;
    border-radius: 14px;
    min-height: 60px;          /* 改为紧凑高度 */
}

QFrame#dropArea:hover {
    border-color: #4f7cff;
    background: #f2f6ff;
}

QLabel#dropIcon {
    font-size: 32px;           /* 缩小图标 */
}

QLabel#dropTitle {
    font-size: 16px;           
    font-weight: 700;
}

QLabel#browseLabel {
    color: #4f7cff;
    font-weight: 700;
}

/* 可选的额外美化（保持与其他控件一致） */
QTableWidget {
    background: #ffffff;
    border: 1px solid #d6dbe6;
    border-radius: 6px;
}

QHeaderView::section {
    background: #e9ecf2;
    color: #2c3e50;
    padding: 6px;
    border: none;
    border-right: 1px solid #d6dbe6;
}

QPushButton {
    background: #e9ecf2;
    border: 1px solid #c5cad4;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background: #d5dae4;
}

QPushButton#mainConvertButton {
    background: #2e7d32;
    color: white;
    border: none;
}

QPushButton#mainConvertButton:hover {
    background: #1f5a24;
}

QComboBox, QSpinBox {
    background: #ffffff;
    border: 1px solid #d6dbe6;
    border-radius: 4px;
    padding: 4px;
}

QProgressBar {
    background: #e9ecf2;
    border: 1px solid #d6dbe6;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background: #4f7cff;
    border-radius: 4px;
}